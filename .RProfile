.env = new.env()

.env$source <- function(file, ..., silent = FALSE) {
  if(isFALSE(silent)) return(base::source(file, ...))
  suppressMessages(suppressWarnings(base::source(file, ...)))
}

attach(.env)
rm(.env)

library(grDevices)
options(
  repos = c(CRAN = "https://cran.rstudio.com")
) 
drat::addRepo("poissonconsulting") 
